# Base URL of the Field Shift backend (the FastAPI app in `backend/`).
#
# Vite bakes this in at build time, so it must be set before `npm run build` for a deployment.
# Left unset, the app talks to the development backend on http://localhost:8000.
VITE_API_BASE_URL=http://localhost:8000

# Field Shift AI (the assistant panel). Set the key in the environment of the backend process, never
# in the repository: this file only lists the names.
#
# FIELD_SHIFT_AI_PROVIDER=openai          # or anthropic; unset means the deterministic adapter
# FIELD_SHIFT_AI_OPENAI_API_KEY=          # the key itself, set it in your shell or service config
# FIELD_SHIFT_AI_OPENAI_MODEL=gpt-5.1     # the model the panel calls
# FIELD_SHIFT_AI_OPENAI_BUDGET_USD=0.50   # set it whenever a key is set: it caps one run's spend
