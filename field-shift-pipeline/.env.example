# Copy this file to .env (same folder) and fill in what you have. .env is gitignored: it never goes to git.
# None of these are needed to run the app; they are only for downloading fresh data.

# USDA NASS Quick Stats, US yields. Free key: https://quickstats.nass.usda.gov/api
NASS_API_KEY=

# Meteomatics forecasts. Account: https://www.meteomatics.com
METEOMATICS_USERNAME=
METEOMATICS_PASSWORD=
