# dependencies
node_modules/

# python virtualenv and bytecode
.venv/
.venv-*/
__pycache__/
*.py[cod]

# build output
dist/
dist-ssr/
.astro/

# capture output from the verification gates
# screenshots are produced by the browser at run time and are not versioned.
# the markdown checkpoints and the json/txt measurement dumps stay in the tree.
field-shift-app/artifacts/*.png

# runtime caches
.tile-cache/

# block 5 polygon build (CO-B5-01, CO-B5-02). the binary products are hundreds of
# megabytes, so they are not versioned; artifacts/polygon-build-manifest.json
# records the absolute path, the size and the sha256 of every one of them. the
# two small Table G records and the class tables under data/polygons stay in the
# tree, because the app reads the manifest at load and the gate reads the records.
field-shift-app/data/polygons/*.pmtiles
# the two United States tiers are the app's own runtime input and are small (about 70 KB and 2 KB),
# so they are versioned; the build copies them into dist/data/polygons. everything else stays out.
!field-shift-app/data/polygons/us-38017-detail.pmtiles
!field-shift-app/data/polygons/us-38017-overview.pmtiles
field-shift-app/data/polygons/*.sqlite
field-shift-app/data/work/

# logs and editor or OS noise
*.log
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea
